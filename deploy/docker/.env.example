# Copy to deploy/docker/.env and replace secrets (never commit .env).
# PHX-G50 / ADR-0069

POSTGRES_PASSWORD=change-me-db
EAOS_JWT_SECRET=change-me-jwt-hs256-secret-at-least-32-chars
EAOS_JWT_ISSUER=https://eaos.local/issuer
EAOS_JWT_AUDIENCE=eaos-api
POSTGRES_HOST_PORT=5432
GATEWAY_HOST_PORT=8000
# Optional deploy-region identity (PHX-G76); leave empty for unlabeled single-host
# EAOS_DEPLOY_REGION=ap-east-1
